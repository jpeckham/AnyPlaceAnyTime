<Project Sdk="Microsoft.NET.Sdk">
 <PropertyGroup>
  <TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
  <AssemblyName>AlwaysSpecial</AssemblyName><Version>0.1.0</Version><EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  <SPTPath Condition="'$(SPTPath)' == ''">C:\sptarkov\SPTarkov 5.0.0-BE-1.3.0.0.48484</SPTPath>
 </PropertyGroup>
 <ItemGroup>
  <Compile Include="src/**/*.cs"/>
  <Reference Include="BepInEx.Core;BepInEx.Unity.IL2CPP;Il2CppInterop.Runtime;Il2CppInterop.Common;0Harmony"><HintPath>$(SPTPath)/BepInEx/core/%(Identity).dll</HintPath><Private>false</Private></Reference>
  <Reference Include="$(SPTPath)/BepInEx/interop/*.dll"><Private>false</Private></Reference>
 </ItemGroup>
 <Target Name="Stage" AfterTargets="Build"><Copy SourceFiles="$(TargetPath);README.md" DestinationFolder="Build/BepInEx/plugins/AlwaysSpecial"/></Target>
</Project>
